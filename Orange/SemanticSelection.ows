		<properties node_id="8" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 1, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x10\x00\x00\x05\xff\x00\x00\x03O\x00\x00\x00\x00\x00\x00\x00\x14\x00\x00\x05\xff\x00\x00\x03s\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x10\x00\x00\x05\xff\x00\x00\x03O', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\nprint ("hrllo")\n', 'filename': None}, {'name': 'New script', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\nprint ("hrllo")\nprint (out_data)\ndata = in_data\nprint(data)', 'filename': None}], 'scriptText': 'import numpy as np\nimport pandas as pd\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n\n\n# Dictionary to store sums\ncol_sums = {}\n\nfor var in in_data.domain.attributes:\n    count = 0\n    \n    for row in in_data:\n        value = row[var]  # Extract the actual value\n        \n        # Skip missing values\n        if value is None or (isinstance(value, float) and np.isnan(value)):\n            continue\n        \n        if var.is_discrete:\n            # For categorical, value is index of the category\n            label = var.values[int(value)]\n            if label == \'1\':\n                count += 1\n        else:\n            # Numeric column\n            count += value\n    \n    col_sums[var.name] = count\n    \n# Keep only part after \'_\' in column names\nnew_col_sums = {name.split(\'_\', 1)[1] if \'_\' in name else name: val\n                for name, val in col_sums.items()}\n\n# Convert to a DataFrame (single-row)\nsum_df = pd.DataFrame([new_col_sums])\n\n# Create new Orange domain\ndomain = Domain([ContinuousVariable(name) for name in sum_df.columns])\n\n# Convert to Orange Table\nout_data = Table.from_numpy(domain, sum_df.to_numpy())', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x01\xfc\x00\x00\x01\x84\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
